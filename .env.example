EXPO_PUBLIC_VISION_BASE_URL=https://your-backend.example.com
EXPO_PUBLIC_VISION_API_KEY=your-app-to-backend-token
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Development only: hide login and use a Supabase anonymous session
DEV_LOGIN_OFF=false

# RevenueCat (public SDK keys; never use the secret key here)
# Precedence: platform key (GOOGLE/APPLE) -> shared key.
# A `test_...` Test Store key works in any build, including release, so Play
# internal-testing builds can run the paywall. It never bills — replace it with
# a live `goog_...` / `appl_...` key before publishing.
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms

# WARNING: EXPO_PUBLIC_* values are inlined into the JS bundle and can be
# extracted from the APK. Use a dedicated low-privilege account with no real
# user data, and enter the same credentials in Play Console -> App access.

# Play reviewer account. Entering this email on the login screen reveals a
# password field; every other account keeps the email magic link.
EXPO_PUBLIC_TEST_EMAIL=
